#!/usr/bin/env bash
set -euo pipefail

REPOS_DIR="${REPOS_DIR:-$HOME/repos}"
WORKSPACES_DIR="${WORKSPACES_DIR:-$REPOS_DIR/workspaces}"

die() {
  echo "workspaces: $*" >&2
  exit 1
}

usage() {
  cat >&2 <<'EOF'
usage:
  workspaces add <name> <repo>...            create/extend a workspace with repo symlinks
  workspaces add-worktree <name> <repo>...   add git worktrees (branch = <name>) to the workspace
  workspaces open <name>                     create/attach the workspace's tmux session
  workspaces list                            list existing workspaces
  workspaces dir <name>                      print workspace dir
EOF
  exit 1
}

cmd_add() {
  [ $# -ge 2 ] || usage
  local name="$1"
  shift
  local ws="$WORKSPACES_DIR/$name"

  local repo
  for repo in "$@"; do
    [ -d "$REPOS_DIR/$repo" ] || die "no such repo: $REPOS_DIR/$repo"
  done

  mkdir -p "$ws"

  for repo in "$@"; do
    local link="$ws/$repo"
    if [ -L "$link" ]; then
      echo "= $repo (already linked)"
    elif [ -e "$link" ]; then
      die "$link exists and is not a symlink"
    else
      ln -s "../../$repo" "$link"
      echo "+ $repo"
    fi
  done

  echo "workspace: $ws"
}

default_branch() {
  local repo_dir="$1" ref
  if ref="$(git -C "$repo_dir" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null)"; then
    echo "${ref#refs/remotes/origin/}"
    return
  fi
  local b
  for b in main master; do
    if git -C "$repo_dir" show-ref --verify --quiet "refs/heads/$b"; then
      echo "$b"
      return
    fi
  done

  if git -C "$repo_dir" remote set-head origin --auto >/dev/null 2>&1 &&
    ref="$(git -C "$repo_dir" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null)"; then
    echo "${ref#refs/remotes/origin/}"
    return
  fi
  die "cannot determine default branch for $repo_dir"
}

cmd_add_worktree() {
  [ $# -ge 2 ] || usage
  local name="$1"
  shift
  local ws="$WORKSPACES_DIR/$name"
  local branch="$name"

  local repo
  for repo in "$@"; do
    local repo_dir="$REPOS_DIR/$repo"
    [ -d "$repo_dir" ] || die "no such repo: $repo_dir"
    git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1 || die "not a git repo: $repo_dir"
  done

  mkdir -p "$ws"

  for repo in "$@"; do
    local repo_dir="$REPOS_DIR/$repo"
    local tree="$ws/$repo"

    if [ -e "$tree" ] || [ -L "$tree" ]; then
      die "$tree already exists"
    fi

    if git -C "$repo_dir" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$repo_dir" worktree add "$tree" "$branch"
      echo "+ $repo (worktree on existing branch $branch)"
    else
      local base
      base="$(default_branch "$repo_dir")"
      git -C "$repo_dir" worktree add -b "$branch" "$tree" "$base"
      echo "+ $repo (worktree on new branch $branch from $base)"
    fi
  done

  echo "workspace: $ws"
}

cmd_open() {
  [ $# -eq 1 ] || usage
  local name="$1"
  local ws="$WORKSPACES_DIR/$name"
  [ -d "$ws" ] || die "no such workspace: $ws"

  if ! tmux has-session -t "$name" 2>/dev/null; then
    tmux new-session -d -s "$name" -c "$ws" -e "WORKSPACE_DIR=$ws" -e "WORKSPACE=$name"
  fi

  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$name"
  else
    tmux attach-session -t "$name"
  fi
}

cmd_list() {
  [ -d "$WORKSPACES_DIR" ] || return 0
  find "$WORKSPACES_DIR" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort
}

cmd_dir() {
  [ $# -eq 1 ] || usage
  local ws="$WORKSPACES_DIR/$1"
  [ -d "$ws" ] || die "no such workspace: $ws"
  echo "$ws"
}

[ $# -ge 1 ] || usage
cmd="$1"
shift
case "$cmd" in
add) cmd_add "$@" ;;
add-worktree) cmd_add_worktree "$@" ;;
open) cmd_open "$@" ;;
list) cmd_list "$@" ;;
dir) cmd_dir "$@" ;;
*) usage ;;
esac
