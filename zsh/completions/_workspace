#compdef workspace

_workspace() {
  local repos_dir="${REPOS_DIR:-$HOME/repos}"

  if (( CURRENT == 2 )); then
    local -a cmds=(
      'add:add repos to the current workspace'
      'warp:cd to the current workspace dir'
      'branch:create a new git branch equal to $WORKSPACE'
    )
    _describe 'command' cmds
    return
  fi

  case "$words[2]" in
    add)
      local -a repos
      repos=( "$repos_dir"/*(/:t) )
      repos=( "${(@)repos:#workspaces}" )
      _describe 'repo' repos
      ;;
    warp)
      ;;
    branch)
      ;;
  esac
}

_workspace "$@"
